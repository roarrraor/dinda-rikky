# Salin file ini menjadi `.env.local` dan isi nilainya.
# Jangan pernah commit `.env.local` — file itu sudah ada di .gitignore.

# URL project Supabase (Dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://xxxx.supabase.co

# Service role key Supabase (Dashboard -> Project Settings -> API -> service_role).
# Kunci ini bisa melewati Row Level Security, jadi RAHASIA — hanya dipakai
# server-side lewat API route, jangan pernah dipakai di kode client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Password untuk masuk ke halaman /admin. Pilih yang kuat dan simpan baik-baik.
ADMIN_PASSWORD=ganti-dengan-password-kuat
