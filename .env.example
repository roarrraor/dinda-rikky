# Salin file ini menjadi `.env.local` dan isi nilainya.
# Jangan pernah commit `.env.local` — file itu sudah ada di .gitignore.

# URL project Supabase (Dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://xxxx.supabase.co

# Publishable / anon key Supabase (Dashboard -> Project Settings -> API ->
# publishable). Key ini BOLEH tampil di publik: policy RLS di migrasi hanya
# mengizinkan anon membaca ucapan, mengirim ucapan/RSVP, dan membaca data
# undangan. Key ini sudah cukup supaya form RSVP & list ucapan berfungsi.
SUPABASE_ANON_KEY=sb_publishable_...

# Service role key Supabase (Dashboard -> Project Settings -> API -> service_role).
# OPSIONAL: hanya dipakai halaman /admin (ubah data undangan, hapus ucapan,
# baca daftar RSVP). Kunci ini bisa melewati Row Level Security, jadi RAHASIA
# — hanya dipakai server-side lewat API route, jangan pernah dipakai di kode
# client, dan jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Password untuk masuk ke halaman /admin. Pilih yang kuat dan simpan baik-baik.
ADMIN_PASSWORD=<redacted>
